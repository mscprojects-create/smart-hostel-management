# ----------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values.
# ----------------------------------------------------------------------------

# PostgreSQL connection string.
# For Vercel: create a free database at https://neon.tech and paste its URL here.
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/hostel?schema=public"

# Direct (non-pooled) connection used for `prisma db push` / migrations.
# Locally you can set this to the SAME value as DATABASE_URL.
# On Vercel the Neon integration provides it automatically.
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/hostel?schema=public"

# Secret used to sign login tokens (JWT). Use any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret-string"

# Token that protects the one-time /api/setup seeding endpoint (production).
# Open /api/setup?token=THIS_VALUE once after deploying to insert demo data.
SETUP_TOKEN="change-me-to-any-secret-value"
